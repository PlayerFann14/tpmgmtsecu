# Variables d'environnement pour le fournisseur réel (aucun secret en dur).
# Copier ce fichier en .env et le remplir, ou exporter ces variables.
# Endpoint compatible OpenAI (ex. testé : https://opencode.ai/inference/openai/v1)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
# Seconds par appel LLM (free tier lent : régler à 600)
OPENAI_TIMEOUT=120